  "history": {
    "0": {
      "0": "The reader spent the day hanging out with Ingrid Gingham on the Venus Quad. Ingrid seemed a little put off by the end of it.",
      "1": "The reader spent the evening alone in his dorm room reviewing his lecture notes. He came out of it feeling a little sharper."
    },
    "1": {
      "0": "The reader sat through Professor Johnson's first Global Survey of Art History: Antiquity to Renaissance lecture with Celest Morokova and Isabelle Carmen in the lecture hall. Professor Johnson walked everyone through the syllabus and the exam dates. Celest compared notes with him afterward.",
      "1": "The reader spent the evening alone in his dorm room doing push-ups and core work. He came out of it feeling a little stronger."
    },
    "2": {
      "0": "The reader sat through Professor Ito's first Studies in Classical Drama and Tragedy lecture with Morgana Notte and Ingrid Gingham in the lecture hall. Professor Ito walked everyone through the syllabus and the exam dates. Morgana compared notes with him afterward.",
      "1": "The reader spent the evening alone in his dorm room rehearsing small talk in the mirror. He came out of it feeling a little more sure of himself."
    },
    "3": {
      "0": "The reader worked through Professor Novikov's Foundations of Percussive Grooves session with Ami Holloway and Celest Morokova in the practice room. Professor Novikov assigned the midterm showcase project. Ami asked how his project was coming along.",
      "1": "The reader sat through Professor Ivanov's first Fermentation Science and Mixology Basics lecture with April Valentine and Winter Yang in the lecture hall. Professor Ivanov walked everyone through the syllabus and the exam dates. April compared notes with him afterward."
    },
    "4": {
      "0": "The reader worked his 1st shift as a Crew Member at Fast Eats, serving Ingrid Gingham at the counter. The rush never let up, but every order went out.",
      "1": "The reader put a work session into his Foundations of Percussive Grooves project in the practice room. He got a solid stretch of work done."
    },
    "5": {
      "0": "The reader spent the day alone in his dorm room stretching and do core work. He came out of it feeling a little stronger.",
      "1": "The reader spent the evening alone in his dorm room rehearsing small talk in the mirror. He came out of it feeling a little more sure of himself."
    },
    "6": {
      "0": "The reader worked his 2nd shift as a Crew Member at Fast Eats, serving Ingrid Gingham at the counter. It was a long shift, and he clocked out tired but steady.",
      "1": "The reader spent the evening alone in his dorm room stretching and do core work. He came out of it feeling a little stronger."
    },
    "7": {
      "0": "The reader ran drills in Coach Orlov's Self-Defense and Combative Arts class with Livvie Tierra and Isabelle Carmen in the Palaestra gym. Coach Orlov kept everyone moving until the whole class was out of breath. Livvie high-fived him on the way out.",
      "1": "The reader put a work session into his Foundations of Percussive Grooves project in the practice room. He got a solid stretch of work done."
    }
