{
  "name": "venus-university",
  "version": "0.0.3",
  "description": "Venus University is a dating sim where you can say and do anything.",
  "main": "./out/main/index.js",
  "author": "Venus Dev",
  "homepage": "https://venus-dev.itch.io/venus-university",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run",
    "dev:web": "vite -c vite.web.config.ts",
    "build:web": "vite build -c vite.web.config.ts",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/graduate": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "7zip-bin": "^5.2.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "motion": "^13.1.1",
    "node-7z": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "signalsmith-stretch": "^1.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.1.2",
    "@types/node-7z": "^2.1.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
